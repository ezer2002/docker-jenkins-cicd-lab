pipeline {
    agent any

    environment {
        BACKEND_IMAGE  = 'gestion-projets-backend'
        FRONTEND_IMAGE = 'gestion-projets-frontend'
        IMAGE_TAG      = "1.0.${BUILD_NUMBER}"
        DOCKERHUB_USER = 'ezer2002'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Backend Image') {
            steps {
                dir('04-fullstack-app-pipeline/backend') {
                    sh 'docker build -t $BACKEND_IMAGE:$IMAGE_TAG .'
                }
            }
        }

        stage('Build Frontend Image') {
            steps {
                dir('04-fullstack-app-pipeline/frontend') {
                    sh 'docker build -t $FRONTEND_IMAGE:$IMAGE_TAG .'
                }
            }
        }

        stage('Push DockerHub') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials',
                                                  usernameVariable: 'DOCKER_USER',
                                                  passwordVariable: 'DOCKER_PASS')]) {
                    sh '''
                        echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                        for IMG in $BACKEND_IMAGE $FRONTEND_IMAGE; do
                            docker tag $IMG:$IMAGE_TAG $DOCKER_USER/$IMG:$IMAGE_TAG
                            docker tag $IMG:$IMAGE_TAG $DOCKER_USER/$IMG:latest
                            docker push $DOCKER_USER/$IMG:$IMAGE_TAG
                            docker push $DOCKER_USER/$IMG:latest
                        done
                    '''
                }
            }
        }

        stage('Deploy Minikube') {
            steps {
                sh '''
                    for f in 10-k8s-deploiement/k8s/*.yaml; do
                        sed -e "s#$BACKEND_IMAGE:latest#$BACKEND_IMAGE:$IMAGE_TAG#" \
                            -e "s#$FRONTEND_IMAGE:latest#$FRONTEND_IMAGE:$IMAGE_TAG#" "$f" | kubectl apply -f -
                    done
                    kubectl rollout status deployment/mysql -n gestion-projets --timeout=300s
                    kubectl rollout status deployment/backend -n gestion-projets --timeout=420s
                    kubectl rollout status deployment/frontend -n gestion-projets --timeout=180s
                    kubectl get pods -n gestion-projets
                '''
            }
        }
    }

    post {
        always {
            sh 'docker logout || true'
        }
    }
}
